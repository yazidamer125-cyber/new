# ----- Turso (libSQL) -----
# turso db create wakilpro && turso db show wakilpro --url
TURSO_DATABASE_URL="libsql://wakilpro-<org>.turso.io"
# turso db tokens create wakilpro
TURSO_AUTH_TOKEN=""

# ----- Better Auth -----
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the deployment (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# ----- Cloudflare R2 (S3-compatible) -----
# Dashboard → R2 → Manage API tokens (Object Read & Write, scoped to the bucket)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="wakilpro"

# ----- Vercel Cron protection (auto-injected by Vercel when set in project env) -----
CRON_SECRET=""

# ----- Optional -----
LOG_LEVEL="info"
# Password used by seed scripts for demo accounts
SEED_PASSWORD="Wakil-Demo-2026!"
